# KisanLink Environment Configuration Template
# Duplicate this file to .env for local/production API wiring

# Deployment Environment (development | staging | production)
NODE_ENV=production
APP_PORT=8080

# Future Backend Integration Targets (Agmarknet & IBM Cloud)
# AGMARKNET_API_ENDPOINT=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
# AGMARKNET_API_KEY=your_agmarknet_api_key_here

# IBM Granite LLM Inference Endpoint (Future Live Agent Wiring)
# IBM_GRANITE_API_KEY=your_ibm_cloud_iam_api_key_here
# IBM_GRANITE_ENDPOINT=https://us-south.ml.cloud.ibm.com/ml/v1/deployments/granite-13b/text/generation
# IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here
